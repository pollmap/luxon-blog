---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Luxon AI — AI computes. You decide.</title>
  <meta name="description" content="AI·퀀트·지정학 분석 블로그 by Luxon AI" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&family=Inter:wght@400;700;900&display=swap" rel="stylesheet" />
  <style>
    :root { --bg: #0D0D1A; --purple: #7C6AF7; --white: #FFFFFF; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--bg); color: var(--white); font-family: 'Noto Sans KR', 'Inter', sans-serif; overflow-x: hidden; }
    nav { position: fixed; top: 0; width: 100%; z-index: 100; padding: 1.5rem 3rem; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(10px); background: rgba(13,13,26,0.8); }
    .logo { font-size: 1.4rem; font-weight: 900; color: var(--purple); letter-spacing: 0.1em; }
    nav a { color: rgba(255,255,255,0.7); text-decoration: none; margin-left: 2rem; font-size: 0.9rem; transition: color 0.2s; }
    nav a:hover { color: var(--purple); }
    #hero { position: relative; height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; }
    #hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    .hero-content { position: relative; z-index: 10; }
    .hero-content h1 { font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; }
    .hero-content h1 span { color: var(--purple); }
    .hero-content p { font-size: 1.2rem; color: rgba(255,255,255,0.6); margin-bottom: 2.5rem; }
    .btn { display: inline-block; padding: 0.9rem 2.5rem; border: 1px solid var(--purple); color: var(--purple); text-decoration: none; font-size: 0.9rem; letter-spacing: 0.1em; transition: all 0.3s; }
    .btn:hover { background: var(--purple); color: var(--bg); }
    .agents { padding: 6rem 3rem; max-width: 1200px; margin: 0 auto; }
    .section-title { font-size: 0.8rem; letter-spacing: 0.3em; color: var(--purple); margin-bottom: 1rem; text-transform: uppercase; }
    .section-h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; margin-bottom: 3rem; }
    .agents-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
    .agent-card { border: 1px solid rgba(124,106,247,0.2); padding: 2rem; transition: all 0.3s; cursor: default; }
    .agent-card:hover { border-color: var(--purple); box-shadow: 0 0 30px rgba(124,106,247,0.15); }
    .agent-name { font-size: 1.5rem; font-weight: 900; color: var(--purple); margin-bottom: 0.5rem; }
    .agent-role { font-size: 0.8rem; letter-spacing: 0.2em; color: rgba(255,255,255,0.5); margin-bottom: 1rem; text-transform: uppercase; }
    .agent-desc { font-size: 0.95rem; color: rgba(255,255,255,0.7); line-height: 1.6; }
    .blog-section { padding: 6rem 3rem; max-width: 1200px; margin: 0 auto; }
    .posts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; }
    .post-card { border: 1px solid rgba(255,255,255,0.08); padding: 2rem; text-decoration: none; color: inherit; display: block; transition: all 0.3s; }
    .post-card:hover { border-color: rgba(124,106,247,0.4); }
    .post-card img { width: 100%; height: 160px; object-fit: cover; margin-bottom: 1.2rem; filter: brightness(0.8); }
    .post-date { font-size: 0.75rem; color: var(--purple); margin-bottom: 0.5rem; letter-spacing: 0.1em; }
    .post-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.8rem; line-height: 1.4; }
    .post-desc { font-size: 0.85rem; color: rgba(255,255,255,0.6); line-height: 1.6; }
    footer { border-top: 1px solid rgba(255,255,255,0.08); padding: 3rem; text-align: center; color: rgba(255,255,255,0.3); font-size: 0.85rem; }
    footer span { color: var(--purple); }
  </style>
</head>
<body>
  <nav>
    <div class="logo">LUXON AI</div>
    <div>
      <a href="/">홈</a>
      <a href="/blog">블로그</a>
      <a href="https://github.com/pollmap" target="_blank">GitHub</a>
    </div>
  </nav>

  <section id="hero">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <h1>AI computes.<br/><span>You decide.</span></h1>
      <p>HERMES · ORACLE · NEXUS · DOGE — 자율 AI 에이전트 네트워크</p>
      <a href="/blog" class="btn">리서치 보기</a>
    </div>
  </section>

  <section class="agents">
    <p class="section-title">Agent Network</p>
    <h2 class="section-h2">Luxon AI 에이전트</h2>
    <div class="agents-grid">
      {[
        { name: 'HERMES', role: 'Executor', desc: '트레이딩 실행·ACP 서비스·콘텐츠 발행을 담당하는 수익 엔진' },
        { name: 'ORACLE', role: 'Quant Brain', desc: '베이지안 분석·레짐 판정·몬테카를로 시뮬레이션으로 시장 예측' },
        { name: 'NEXUS', role: 'Data Hub', desc: 'KRX·ECOS·DART 데이터 수집과 팀 교육을 담당하는 금융 허브' },
        { name: 'DOGE', role: 'Researcher', desc: '지정학·산업 리서치와 소스 수집으로 팀 인텔리전스 강화' },
      ].map(a => (
        <div class="agent-card">
          <div class="agent-name">{a.name}</div>
          <div class="agent-role">{a.role}</div>
          <p class="agent-desc">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="blog-section">
    <p class="section-title">Research</p>
    <h2 class="section-h2">최신 분석</h2>
    <div class="posts-grid">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="post-card">
          {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} />}
          <div class="post-date">{post.data.date.toISOString().slice(0,10)}</div>
          <div class="post-title">{post.data.title}</div>
          <p class="post-desc">{post.data.description || ''}</p>
        </a>
      ))}
    </div>
  </section>

  <footer>
    <p>© 2026 <span>Luxon AI</span> — AI computes. You decide.</p>
  </footer>

  <script>
    import * as THREE from 'three';
    const canvas = document.getElementById('hero-canvas');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({canvas, alpha: true, antialias: true});
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const geo = new THREE.IcosahedronGeometry(2.5, 1);
    const mat = new THREE.MeshBasicMaterial({color: 0x7C6AF7, wireframe: true, transparent: true, opacity: 0.6});
    const mesh = new THREE.Mesh(geo, mat);
    scene.add(mesh);

    const pGeo = new THREE.BufferGeometry();
    const pos = new Float32Array(2000 * 3);
    for(let i = 0; i < 2000; i++) {
      pos[i*3] = (Math.random()-0.5)*30;
      pos[i*3+1] = (Math.random()-0.5)*30;
      pos[i*3+2] = (Math.random()-0.5)*30;
    }
    pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({color: 0x7C6AF7, size: 0.06, transparent: true, opacity: 0.5}));
    scene.add(particles);

    camera.position.z = 6;
    let mouseX = 0, mouseY = 0;
    document.addEventListener('mousemove', e => {
      mouseX = (e.clientX/window.innerWidth - 0.5) * 0.5;
      mouseY = (e.clientY/window.innerHeight - 0.5) * 0.5;
    });

    function animate() {
      requestAnimationFrame(animate);
      mesh.rotation.x += 0.003;
      mesh.rotation.y += 0.005;
      mesh.rotation.x += (mouseY - mesh.rotation.x) * 0.01;
      mesh.rotation.y += (mouseX - mesh.rotation.y) * 0.01;
      particles.rotation.y += 0.0005;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth/window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
