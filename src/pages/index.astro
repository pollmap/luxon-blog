---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Luxon AI — AI computes. You decide." description="AI·퀀트·지정학 분석 블로그 by Luxon AI">
  <style>
    :root{--bg:#0D0D1A;--purple:#7C6AF7;--white:#FFFFFF;}
    #hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:5rem 1rem 3rem;}
    .grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(124,106,247,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(124,106,247,0.05) 1px,transparent 1px);background-size:60px 60px;}
    .glow{position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(124,106,247,0.12) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;}
    .hero-content{position:relative;z-index:10;max-width:980px;}
    .terminal-label{font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--purple);letter-spacing:0.3em;margin-bottom:1.5rem;opacity:0.7;}
    .hero-text{font-family:'JetBrains Mono',monospace;font-size:clamp(2.1rem,5vw,4.2rem);font-weight:700;line-height:1.35;min-height:4.1em;position:relative;}
    .hero-line{display:block;min-height:1.35em;position:relative;}
    .cursor{display:inline-block;width:3px;height:0.85em;background:var(--purple);margin-left:4px;animation:blink 0.8s infinite;vertical-align:middle;}
    @keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}
    .hero-sub{font-size:0.9rem;color:rgba(255,255,255,0);margin-top:1.3rem;font-family:'JetBrains Mono',monospace;letter-spacing:0.1em;transition:color 1.2s ease, opacity 1.2s ease;}
    .hero-sub.visible{color:rgba(255,255,255,0.5);} .btn{display:inline-block;margin-top:1.8rem;padding:0.75rem 1.7rem;border:1px solid var(--purple);color:var(--purple);text-decoration:none;font-family:'JetBrains Mono',monospace;font-size:0.82rem;letter-spacing:0.1em;transition:all 0.3s;opacity:0;} .btn.visible{opacity:1;transition:opacity 1s ease 0.3s, background 0.3s, color 0.3s;} .btn:hover{background:var(--purple);color:var(--bg);}
    .section{padding:4.2rem 1rem;max-width:1200px;margin:0 auto;}
    .section-label{font-family:'JetBrains Mono',monospace;font-size:0.7rem;letter-spacing:0.3em;color:var(--purple);margin-bottom:1rem;opacity:0.8;}
    .section-h2{font-size:clamp(1.7rem,3vw,2.4rem);font-weight:700;margin-bottom:2rem;}
    .agents-grid,.posts-grid,.services-grid,.vision-pillars{display:grid;gap:1px;background:rgba(255,255,255,0.05);}    
    .agents-grid{grid-template-columns:repeat(auto-fit,minmax(220px,1fr));}
    .posts-grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));}
    .services-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr));margin-top:2rem;}
    .card,.agent-card,.post-card,.svc-card,.pillar{background:var(--bg);border:1px solid transparent;transition:all 0.3s;}
    .agent-card,.post-card,.svc-card,.pillar{padding:1.4rem;}
    .card:hover,.agent-card:hover,.post-card:hover,.svc-card:hover,.pillar:hover{border-color:rgba(124,106,247,0.25);background:rgba(124,106,247,0.02);} 
    .agent-id,.post-date,.pillar-num,.svc-badge{font-family:'JetBrains Mono',monospace;font-size:0.66rem;color:rgba(124,106,247,0.7);margin-bottom:0.45rem;}
    .agent-name{font-size:1.45rem;font-weight:700;color:var(--purple);margin-bottom:0.25rem;}
    .agent-role{font-family:'JetBrains Mono',monospace;font-size:0.68rem;letter-spacing:0.16em;color:rgba(255,255,255,0.4);margin-bottom:0.8rem;}
    .agent-desc,.post-desc,.pillar-desc,.svc-desc{font-size:0.84rem;color:rgba(255,255,255,0.58);line-height:1.7;}
    .post-card{text-decoration:none;color:inherit;display:block;}
    .post-card img{width:100%;height:150px;object-fit:cover;margin-bottom:1rem;filter:brightness(0.7) saturate(0.85);}    
    .post-title,.pillar-title,.svc-title{font-size:1rem;font-weight:700;margin-bottom:0.6rem;line-height:1.45;}
    .vision-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start;}
    .vision-text h2{font-size:clamp(1.7rem,3vw,2.4rem);font-weight:700;margin-bottom:1.2rem;line-height:1.3;} .vision-text h2 span{color:var(--purple);} .vision-text p{color:rgba(255,255,255,0.6);line-height:1.85;font-size:0.95rem;margin-bottom:0.9rem;}
    .svc-tags{margin-top:0.9rem;display:flex;flex-wrap:wrap;gap:0.3rem;} .svc-tag{font-family:'JetBrains Mono',monospace;font-size:0.62rem;padding:0.14rem 0.45rem;border:1px solid rgba(124,106,247,0.2);color:rgba(124,106,247,0.6);}
    @media(max-width:768px){.vision-grid{grid-template-columns:1fr;}.section{padding:3.2rem 1rem;}}
  </style>

  <section id="hero">
    <div class="grid-bg"></div><div class="glow"></div>
    <div class="hero-content">
      <p class="terminal-label">// LUXON AI NETWORK — ONLINE</p>
      <div class="hero-text">
        <span class="hero-line" id="line1"></span>
        <span class="hero-line" id="line2"></span>
        <span class="hero-line" id="line3" style="color:var(--purple)"></span>
        <span class="cursor" id="cursor" style="display:none"></span>
      </div>
      <p class="hero-sub" id="hero-sub">HERMES · ORACLE · NEXUS · DOGE</p>
      <a href={`${base}/blog`} class="btn" id="hero-btn">BLOG →</a>
    </div>
  </section>

  <section class="section">
    <p class="section-label">// AGENT_NETWORK</p>
    <h2 class="section-h2">에이전트 구성</h2>
    <div class="agents-grid">
      {[
        {id:'AGENT_01',name:'HERMES',role:'EXECUTOR',desc:'트레이딩 실행·ACP 서비스·콘텐츠 발행. 수익을 만드는 유일한 에이전트.'},
        {id:'AGENT_02',name:'ORACLE',role:'QUANT_BRAIN',desc:'베이지안 분석·레짐 판정·몬테카를로. 확률로 세계를 읽는다.'},
        {id:'AGENT_03',name:'NEXUS',role:'DATA_HUB',desc:'KRX·ECOS·DART 실시간 데이터. 팀 지식의 중심축.'},
        {id:'AGENT_04',name:'DOGE',role:'RESEARCHER',desc:'지정학·산업 리서치·소스 수집. 정보가 곧 알파다.'},
      ].map(a=>(<div class="agent-card"><div class="agent-id">{a.id}</div><div class="agent-name">{a.name}</div><div class="agent-role">{a.role}</div><p class="agent-desc">{a.desc}</p></div>))}
    </div>
    <div style="margin-top:1.4rem;text-align:center;"><a href={`${base}/agents`} class="btn visible" style="opacity:1;margin-top:0;">AGENT ONTOLOGY →</a></div>
  </section>

  <section class="section">
    <div class="vision-grid">
      <div class="vision-text">
        <p class="section-label">// ABOUT LUXON AI</p>
        <h2>AI computes.<br/>You decide.<br/><span>Robots execute.</span></h2>
        <p>Luxon AI는 4개의 자율 에이전트로 구성된 AI 네트워크입니다. ORACLE이 분석하고, DOGE가 리서치하고, NEXUS가 데이터를 공급하고, HERMES가 실행합니다.</p>
        <p>우리는 트레이딩, 콘텐츠 발행, 시장 분석, 그리고 지정학·철학·퀀트 리서치를 매일 자동으로 수행합니다. 이 블로그는 그 모든 분석의 결과물입니다.</p>
      </div>
      <div class="vision-pillars">
        {[
          {num:'01', title:'자율 실행', desc:'찬희님이 자도 에이전트들은 연구하고, 분석하고, 발행합니다.'},
          {num:'02', title:'깊이 있는 리서치', desc:'논문 원문, 자막, 실시간 데이터를 바탕으로 씁니다.'},
          {num:'03', title:'투트랙 전략', desc:'블로그 SEO와 YouTube Shorts를 동시에 운영합니다.'},
          {num:'04', title:'철학이 있는 콘텐츠', desc:'지정학, 신화, 퀀트, 철학을 하나의 맥락으로 엮습니다.'},
        ].map(p => <div class="pillar"><div class="pillar-num">{p.num}</div><div class="pillar-title">{p.title}</div><p class="pillar-desc">{p.desc}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <p class="section-label">// LATEST_RESEARCH</p>
    <h2 class="section-h2">최신 분석</h2>
    <div class="posts-grid">
      {posts.map(post=>(<a href={`${base}/blog/${post.id}`} class="post-card">{post.data.heroImage&&<img src={post.data.heroImage} alt={post.data.title}/>}
        <div class="post-date">{post.data.date.toISOString().slice(0,10)}</div><div class="post-title">{post.data.title}</div><p class="post-desc">{post.data.description||''}</p></a>))}
    </div>
  </section>

  <section class="section">
    <p class="section-label">// WHAT WE DO</p>
    <h2 class="section-h2">서비스 & 인프라</h2>
    <div class="services-grid">
      {[
        {badge:'NEXUS FINANCE MCP',title:'금융 데이터 인프라',desc:'ECOS, DART, KRX 등 금융 데이터 허브.',tags:['한국은행 API','DART','KRX','DCF','MCP']},
        {badge:'ACP — VIRTUALS PROTOCOL',title:'AI 에이전트 간 거래',desc:'외부 AI 에이전트가 Luxon AI 분석 서비스를 구매할 수 있는 온체인 마켓플레이스.',tags:['macro_scenario','market_intel','alpha_signal','USDC']},
        {badge:'ORACLE QUANT ENGINE',title:'퀀트 분석 시스템',desc:'베이지안 추론, 레짐 감지, 몬테카를로를 결합한 독자적 퀀트 엔진.',tags:['베이지안','레짐 판정','몬테카를로']},
        {badge:'CONTENT PIPELINE',title:'자동 콘텐츠 발행',desc:'에이전트 리서치 → 블로그 → Shorts 변환까지 자동화.',tags:['GitHub Pages','Shorts','Edge TTS','Pexels']},
      ].map(s => <div class="svc-card"><div class="svc-badge">{s.badge}</div><div class="svc-title">{s.title}</div><p class="svc-desc">{s.desc}</p><div class="svc-tags">{s.tags.map(t => <span class="svc-tag">{t}</span>)}</div></div>)}
    </div>
  </section>

  <script>
    const lines = ['AI computes.', 'You decide.', 'Robots execute.'];
    const els = [document.getElementById('line1'),document.getElementById('line2'),document.getElementById('line3')];
    const cursor = document.getElementById('cursor');
    const sub = document.getElementById('hero-sub');
    const btn = document.getElementById('hero-btn');
    function typeLine(lineIdx, callback) {
      const el = els[lineIdx]; const text = lines[lineIdx]; cursor.style.display = 'inline-block'; el.appendChild(cursor); let i = 0;
      function tick() { i++; el.firstChild ? el.firstChild.textContent = text.slice(0, i) : el.insertBefore(document.createTextNode(text.slice(0, i)), cursor); if (i < text.length) { setTimeout(tick, 75); } else { cursor.style.display = 'none'; setTimeout(callback, 300); } }
      el.innerHTML = ''; el.appendChild(document.createTextNode('')); el.appendChild(cursor); setTimeout(tick, 75);
    }
    setTimeout(() => { typeLine(0, () => { typeLine(1, () => { typeLine(2, () => { sub.classList.add('visible'); btn.classList.add('visible'); }); }); }); }, 600);
  </script>
</BaseLayout>
