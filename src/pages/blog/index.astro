---
import { getCollection } from 'astro:content';
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 카테고리 목록
const CATEGORIES = [
  { tag: '지정학', label: '지정학', emoji: '🌍' },
  { tag: '게임이론', label: '게임이론', emoji: '♟️' },
  { tag: '퀀트', label: '퀀트', emoji: '📊' },
  { tag: '매크로경제', label: '매크로경제', emoji: '📈' },
  { tag: 'AI', label: 'AI·기술', emoji: '🤖' },
  { tag: '크립토', label: '크립토', emoji: '₿' },
  { tag: 'ORACLE리서치', label: 'ORACLE 리서치', emoji: '🔬' },
];

const selectedTag = Astro.url.searchParams.get('tag') || '';
const posts = selectedTag
  ? allPosts.filter(p => (p.data.tags || []).includes(selectedTag))
  : allPosts;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>리서치 — Luxon AI</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#0D0D1A;--purple:#7C6AF7;--white:#FFFFFF;}
    *{margin:0;padding:0;box-sizing:border-box;}
    body{background:var(--bg);color:var(--white);font-family:'Noto Sans KR',sans-serif;}
    nav{position:fixed;top:0;width:100%;z-index:100;padding:1.5rem 3rem;display:flex;justify-content:space-between;align-items:center;backdrop-filter:blur(10px);background:rgba(13,13,26,0.85);}
    .logo{font-family:'JetBrains Mono',monospace;font-size:1.2rem;font-weight:700;color:var(--purple);text-decoration:none;}
    nav a{color:rgba(255,255,255,0.6);text-decoration:none;margin-left:2rem;font-size:0.85rem;}
    nav a:hover{color:var(--purple);}
    main{max-width:1200px;margin:0 auto;padding:8rem 3rem 4rem;}
    h1{font-size:2.5rem;font-weight:700;margin-bottom:0.5rem;}
    .subtitle{color:rgba(255,255,255,0.4);font-family:'JetBrains Mono',monospace;font-size:0.8rem;margin-bottom:2.5rem;}
    .cats{display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:3rem;}
    .cat{display:inline-flex;align-items:center;gap:0.4rem;padding:0.4rem 1rem;border:1px solid rgba(124,106,247,0.25);color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.82rem;font-family:'JetBrains Mono',monospace;transition:all 0.2s;white-space:nowrap;}
    .cat:hover,.cat.active{border-color:var(--purple);color:var(--purple);}
    .cat-all{border-color:rgba(255,255,255,0.15);}
    .posts{display:grid;gap:1px;background:rgba(255,255,255,0.05);}
    .post{background:var(--bg);padding:1.8rem 2rem;text-decoration:none;color:inherit;display:grid;grid-template-columns:120px 1fr;gap:1.5rem;align-items:start;border:1px solid transparent;transition:border-color 0.2s;}
    .post:hover{border-color:rgba(124,106,247,0.3);}
    .post-thumb{width:120px;height:80px;object-fit:cover;filter:brightness(0.7);}
    .post-thumb-placeholder{width:120px;height:80px;background:rgba(124,106,247,0.07);display:flex;align-items:center;justify-content:center;color:var(--purple);font-size:1.5rem;}
    .post-date{font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--purple);margin-bottom:0.4rem;opacity:0.8;}
    .post-title{font-size:1rem;font-weight:700;margin-bottom:0.5rem;line-height:1.5;}
    .post-desc{font-size:0.82rem;color:rgba(255,255,255,0.5);line-height:1.6;}
    .post-tags{margin-top:0.6rem;display:flex;gap:0.4rem;flex-wrap:wrap;}
    .tag-chip{font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:rgba(124,106,247,0.7);border:1px solid rgba(124,106,247,0.2);padding:0.15rem 0.5rem;}
    .empty{text-align:center;padding:4rem;color:rgba(255,255,255,0.3);font-family:'JetBrains Mono',monospace;}
  </style>
</head>
<body>
  <nav>
    <a href={`${base}/`} class="logo">LUXON_AI</a>
    <div>
      <a href={`${base}/`}>HOME</a>
      <a href={`${base}/blog`}>RESEARCH</a>
      <a href="https://github.com/pollmap" target="_blank">GITHUB</a>
    </div>
  </nav>
  <main>
    <h1>리서치</h1>
    <p class="subtitle">// {allPosts.length} ARTICLES — AI · 퀀트 · 지정학 · 매크로</p>

    <div class="cats">
      <a href={`${base}/blog`} class={`cat cat-all ${!selectedTag ? 'active' : ''}`}>ALL ({allPosts.length})</a>
      {CATEGORIES.map(c => {
        const count = allPosts.filter(p => (p.data.tags || []).includes(c.tag)).length;
        if (count === 0) return null;
        return (
          <a href={`${base}/blog?tag=${c.tag}`} class={`cat ${selectedTag === c.tag ? 'active' : ''}`}>
            {c.emoji} {c.label} ({count})
          </a>
        );
      })}
    </div>

    {posts.length === 0 ? (
      <div class="empty">// NO ARTICLES IN THIS CATEGORY YET</div>
    ) : (
      <div class="posts">
        {posts.map(post => (
          <a href={`${base}/blog/${post.id}`} class="post">
            {post.data.heroImage
              ? <img class="post-thumb" src={post.data.heroImage} alt={post.data.title} />
              : <div class="post-thumb-placeholder">📊</div>
            }
            <div>
              <div class="post-date">{post.data.date.toISOString().slice(0,10)}</div>
              <div class="post-title">{post.data.title}</div>
              <p class="post-desc">{post.data.description || ''}</p>
              <div class="post-tags">
                {(post.data.tags || []).slice(0, 3).map(tag => (
                  <span class="tag-chip">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</body>
</html>
