---
import { getCollection } from 'astro:content';
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tagCounts = allPosts.flatMap(p => p.data.tags || []).reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const PER_PAGE = 10;
const totalPages = Math.ceil(allPosts.length / PER_PAGE);
const posts = allPosts.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const pageUrl = (p: number) => {
  const q = p > 1 ? `?page=${p}` : '';
  return `${base}/blog${q}`;
};

const searchIndex = allPosts.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description || '',
  tags: p.data.tags || [],
  date: p.data.date.toISOString().slice(0,10),
  url: `${base}/blog/${p.id}`,
  heroImage: p.data.heroImage || '',
}));
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BLOG — LUXON AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#0D0D1A;--bg2:#111122;--purple:#7C6AF7;--white:#FFFFFF;--border:rgba(255,255,255,0.07);}
    *{margin:0;padding:0;box-sizing:border-box;}
    html,body{overflow-x:hidden;max-width:100%;}
    body{background:var(--bg);color:var(--white);font-family:'Pretendard Variable',Pretendard,-apple-system,BlinkMacSystemFont,'Noto Sans KR',sans-serif;}

    /* ── NAV ───────────────────────────────────── */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0.75rem 1rem;display:flex;justify-content:space-between;align-items:center;background:rgba(13,13,26,0.97);border-bottom:1px solid var(--border);}
    .logo{font-family:'JetBrains Mono',monospace;font-size:0.95rem;font-weight:700;color:var(--purple);text-decoration:none;white-space:nowrap;}
    .nav-links{display:flex;gap:1rem;flex-shrink:0;}
    .nav-links a{color:rgba(255,255,255,0.55);text-decoration:none;font-size:0.75rem;font-family:'JetBrains Mono',monospace;white-space:nowrap;}
    .nav-links a:hover{color:var(--purple);}

    /* ── SEARCH BAR ────────────────────────────── */
    .search-bar-wrap{position:sticky;top:49px;z-index:90;background:var(--bg);border-bottom:1px solid var(--border);padding:0.6rem 1rem;}
    .search-inner{position:relative;max-width:800px;margin:0 auto;}
    .search-input{width:100%;background:var(--bg2);border:1px solid rgba(124,106,247,0.3);color:var(--white);padding:0.55rem 0.9rem 0.55rem 2.2rem;font-size:0.82rem;font-family:'JetBrains Mono',monospace;outline:none;transition:border-color 0.2s;-webkit-appearance:none;border-radius:0;}
    .search-input:focus{border-color:var(--purple);}
    .search-input::placeholder{color:rgba(255,255,255,0.22);}
    .search-icon{position:absolute;left:0.65rem;top:50%;transform:translateY(-50%);color:rgba(124,106,247,0.5);font-size:0.85rem;pointer-events:none;line-height:1;}

    /* ── LAYOUT ────────────────────────────────── */
    .layout{max-width:860px;margin:0 auto;padding:1rem 1rem 4rem;}

    /* ── CATEGORY CHIPS ────────────────────────── */
    .cat-wrap{margin-bottom:1rem;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;/* overflow 경계 명확히 */contain:inline-size;}
    .cat-wrap::-webkit-scrollbar{display:none;}
    .cat-chips{display:flex;gap:0.4rem;flex-wrap:nowrap;padding-bottom:2px;width:max-content;/* body overflow-x hidden 우회 방지 */}
    .cat-chip{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:0.68rem;padding:0.28rem 0.65rem;border:1px solid rgba(124,106,247,0.22);color:rgba(255,255,255,0.5);background:var(--bg2);cursor:pointer;white-space:nowrap;transition:all 0.15s;text-decoration:none;line-height:1.4;}
    .cat-chip:hover,.cat-chip.active{border-color:var(--purple);color:var(--purple);background:rgba(124,106,247,0.08);}

    /* ── PAGE HEADER ───────────────────────────── */
    .page-header{display:flex;align-items:baseline;gap:0.6rem;flex-wrap:wrap;margin-bottom:0.9rem;}
    .page-header h1{font-size:1.25rem;font-weight:700;font-family:'JetBrains Mono',monospace;}
    .result-info{font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:rgba(255,255,255,0.28);}

    /* ── POST CARD ─────────────────────────────── */
    .post-list,.search-result-list{display:flex;flex-direction:column;gap:1px;background:var(--border);}
    .post-card{background:var(--bg);display:grid;grid-template-columns:80px 1fr;gap:0.8rem;padding:0.9rem;text-decoration:none;color:inherit;border:1px solid transparent;transition:border-color 0.2s;min-width:0;}
    .post-card:hover{border-color:rgba(124,106,247,0.25);background:rgba(124,106,247,0.02);}
    .post-thumb-wrap{width:80px;height:56px;flex-shrink:0;overflow:hidden;}
    .post-thumb{width:80px;height:56px;object-fit:cover;filter:brightness(0.75);display:block;}
    .post-thumb-ph{width:80px;height:56px;background:rgba(124,106,247,0.06);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:rgba(124,106,247,0.4);}
    .post-body{min-width:0;overflow:hidden;}
    .post-date{font-family:'JetBrains Mono',monospace;font-size:0.62rem;color:rgba(124,106,247,0.7);margin-bottom:0.22rem;}
    .post-title{font-size:0.88rem;font-weight:700;line-height:1.38;margin-bottom:0.28rem;overflow-wrap:break-word;word-break:break-word;}
    .post-desc{font-size:0.73rem;color:rgba(255,255,255,0.38);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;}
    .post-tags{margin-top:0.38rem;display:flex;gap:0.22rem;flex-wrap:wrap;}
    .tag{font-family:'JetBrains Mono',monospace;font-size:0.58rem;color:rgba(124,106,247,0.6);border:1px solid rgba(124,106,247,0.18);padding:0.06rem 0.35rem;white-space:nowrap;}

    /* ── PAGINATION ────────────────────────────── */
    .pagination{display:flex;gap:0.3rem;margin-top:1.4rem;align-items:center;flex-wrap:wrap;}
    .pg-btn{font-family:'JetBrains Mono',monospace;font-size:0.7rem;padding:0.35rem 0.75rem;border:1px solid rgba(124,106,247,0.3);color:var(--purple);text-decoration:none;transition:all 0.2s;white-space:nowrap;}
    .pg-btn:hover{background:var(--purple);color:var(--bg);}
    .pg-num{font-family:'JetBrains Mono',monospace;font-size:0.7rem;padding:0.35rem 0.6rem;border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.4);text-decoration:none;transition:all 0.2s;}
    .pg-num:hover,.pg-num.active{border-color:var(--purple);color:var(--purple);background:rgba(124,106,247,0.08);}

    /* ── SEARCH STATES ─────────────────────────── */
    .no-result{padding:2rem;text-align:center;font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:rgba(255,255,255,0.28);}
    mark{background:rgba(124,106,247,0.28);color:#fff;padding:0 1px;border-radius:1px;}

    /* ── MOBILE TWEAKS ─────────────────────────── */
    @media(max-width:380px){
      .post-card{grid-template-columns:64px 1fr;gap:0.6rem;padding:0.75rem;}
      .post-thumb-wrap,.post-thumb,.post-thumb-ph{width:64px;height:46px;}
      .post-title{font-size:0.82rem;}
    }
  </style>
</head>
<body>
  <!-- NAV -->
  <nav>
    <a href={`${base}/`} class="logo">⬡ LUXON</a>
    <div class="nav-links">
      <a href={`${base}/`}>HOME</a>
      <a href={`${base}/blog`}>BLOG</a>
      <a href={`${base}/agents`}>AGENTS</a>
    </div>
  </nav>

  <!-- SEARCH BAR -->
  <div class="search-bar-wrap">
    <div class="search-inner">
      <span class="search-icon">🔍</span>
      <input id="search-input" class="search-input" type="search"
        placeholder="제목·태그·설명 검색..." autocomplete="off" />
    </div>
  </div>

  <div class="layout">

    <!-- CATEGORY CHIPS -->
    <div class="cat-wrap">
      <div class="cat-chips">
        <a href={`${base}/blog`} class="cat-chip">ALL&nbsp;{allPosts.length}</a>
        {sortedTags.map(([tag, count]) => (
          <a href={`${base}/category/${tag.toLowerCase().replace(/\s+/g,'-')}`} class="cat-chip">
            {tag}&nbsp;{count}
          </a>
        ))}
      </div>
    </div>

    <!-- HEADER -->
    <div class="page-header">
      <h1>BLOG</h1>
      <span class="result-info" id="result-info">// {allPosts.length} posts — {page}/{totalPages}</span>
    </div>

    <!-- 기본 목록 -->
    <div class="post-list" id="post-list">
      {posts.map(post => (
        <a href={`${base}/blog/${post.id}`} class="post-card">
          <div class="post-thumb-wrap">
            {post.data.heroImage
              ? <img class="post-thumb" src={post.data.heroImage} alt="" loading="lazy" />
              : <div class="post-thumb-ph">📊</div>}
          </div>
          <div class="post-body">
            <div class="post-date">{post.data.date.toISOString().slice(0,10)}</div>
            <div class="post-title">{post.data.title}</div>
            <p class="post-desc">{post.data.description || ''}</p>
            <div class="post-tags">
              {(post.data.tags||[]).slice(0,3).map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- 검색 결과 -->
    <div class="search-result-list" id="search-results" style="display:none;"></div>

    <!-- PAGINATION -->
    <div class="pagination" id="pagination">
      {page > 1 && <a href={pageUrl(page-1)} class="pg-btn">← PREV</a>}
      {Array.from({length:totalPages},(_,i)=>i+1).map(p=>(
        <a href={pageUrl(p)} class={`pg-num${p===page?' active':''}`}>{p}</a>
      ))}
      {page < totalPages && <a href={pageUrl(page+1)} class="pg-btn">NEXT →</a>}
    </div>

  </div>

  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)}></script>

  <script>
    const INDEX = JSON.parse(document.getElementById('search-data')!.textContent!);
    const inp  = document.getElementById('search-input') as HTMLInputElement;
    const list = document.getElementById('post-list') as HTMLElement;
    const srch = document.getElementById('search-results') as HTMLElement;
    const pagi = document.getElementById('pagination') as HTMLElement;
    const info = document.getElementById('result-info') as HTMLElement;

    function esc(s:string){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));}
    function hl(text:string,q:string){
      if(!q.trim())return esc(text);
      const terms=q.trim().split(/\s+/).map(t=>t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'));
      return esc(text).replace(new RegExp(`(${terms.join('|')})`, 'gi'),'<mark>$1</mark>');
    }
    function score(p:any,q:string){
      const terms=q.toLowerCase().split(/\s+/).filter(Boolean);
      let s=0;
      for(const t of terms){
        if(p.title.toLowerCase().includes(t)) s+=10;
        if(p.description.toLowerCase().includes(t)) s+=5;
        if(p.tags.some((x:string)=>x.toLowerCase().includes(t))) s+=8;
      }
      return s;
    }
    function cardHTML(p:any,q:string){
      const thumb=p.heroImage
        ?`<img style="width:80px;height:56px;object-fit:cover;filter:brightness(0.75);display:block;" src="${esc(p.heroImage)}" alt="" loading="lazy"/>`
        :`<div style="width:80px;height:56px;background:rgba(124,106,247,0.06);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:rgba(124,106,247,0.4);">📊</div>`;
      const tags=(p.tags||[]).slice(0,3).map((t:string)=>`<span class="tag">${esc(t)}</span>`).join('');
      return `<a href="${esc(p.url)}" class="post-card">
        <div class="post-thumb-wrap">${thumb}</div>
        <div class="post-body">
          <div class="post-date">${esc(p.date)}</div>
          <div class="post-title">${hl(p.title,q)}</div>
          <p class="post-desc">${hl(p.description,q)}</p>
          <div class="post-tags">${tags}</div>
        </div>
      </a>`;
    }

    function render(q:string){
      const trimQ=q.trim();
      if(!trimQ){
        list.style.display='';
        srch.style.display='none';
        pagi.style.display='';
        info.textContent=`// ${INDEX.length} posts`;
        return;
      }
      const hits=INDEX.map((p:any)=>({p,s:score(p,trimQ)})).filter((r:any)=>r.s>0).sort((a:any,b:any)=>b.s-a.s);
      list.style.display='none';
      pagi.style.display='none';
      srch.style.display='';
      info.textContent=`// 검색 ${hits.length}건`;
      if(!hits.length){srch.innerHTML=`<div class="no-result">결과 없음 — "${esc(trimQ)}"</div>`;return;}
      srch.innerHTML=hits.map(({p}:any)=>cardHTML(p,trimQ)).join('');
    }

    let timer:any;
    inp.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>render(inp.value),160);});

    const urlQ=new URLSearchParams(location.search).get('q');
    if(urlQ){inp.value=urlQ;render(urlQ);}
  </script>
</body>
</html>
