---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagCounts = allPosts.flatMap(p => p.data.tags || []).reduce((acc, tag) => { acc[tag] = (acc[tag] || 0) + 1; return acc; }, {} as Record<string, number>);
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const searchIndex = allPosts.map(p => ({ id:p.id,title:p.data.title,description:p.data.description || '',tags:p.data.tags || [],date:p.data.date.toISOString().slice(0,10),url:`${base}/blog/${p.id}`,heroImage:p.data.heroImage || '' }));
---
<BaseLayout title="BLOG — LUXON AI" description="Luxon AI 블로그 목록">
  <style is:global>
    .blog-wrap{max-width:860px;margin:0 auto;padding:5.7rem 1rem 0;}
    .blog-search-bar-wrap{position:sticky;top:53px;z-index:90;background:var(--bg-primary);border-bottom:1px solid var(--border);padding:0.6rem 1rem;margin:0 -1rem 1rem;}
    .blog-search-inner{position:relative;max-width:860px;margin:0 auto;}
    .blog-search-input{width:100%;background:var(--bg-secondary);border:1px solid rgba(124,106,247,0.3);color:#fff;padding:0.55rem 0.9rem 0.55rem 2.2rem;font-size:0.82rem;font-family:'JetBrains Mono',monospace;outline:none;border-radius:0;}
    .blog-search-icon{position:absolute;left:0.65rem;top:50%;transform:translateY(-50%);color:rgba(124,106,247,0.5);font-size:0.85rem;}
    .blog-cat-wrap{margin-bottom:1rem;overflow-x:auto;scrollbar-width:none;}.blog-cat-wrap::-webkit-scrollbar{display:none}
    .blog-cat-chips{display:flex;gap:0.4rem;width:max-content;padding-bottom:2px;}
    .blog-cat-chip{display:inline-block;padding:0.3rem 0.7rem;background:var(--bg-secondary);border:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--text-muted);text-decoration:none;white-space:nowrap}
    .blog-cat-chip:hover{color:var(--accent-light);border-color:rgba(124,106,247,0.35);background:rgba(124,106,247,0.06)}
    .blog-head{display:flex;align-items:baseline;gap:0.6rem;flex-wrap:wrap;margin-bottom:0.9rem}
    .blog-head h1{font-size:1.28rem;font-weight:800;font-family:'JetBrains Mono',monospace}
    .blog-result-info{font-family:'JetBrains Mono',monospace;font-size:0.66rem;color:var(--text-muted)}
    .blog-post-list{display:flex;flex-direction:column;gap:1px;background:var(--border)}
    .blog-post-card{background:var(--bg-primary);display:grid;grid-template-columns:80px 1fr;gap:0.8rem;padding:0.9rem;text-decoration:none;color:inherit;border:1px solid transparent}
    .blog-post-card:hover{border-color:rgba(124,106,247,0.25);background:rgba(124,106,247,0.02)}
    .blog-thumb{width:80px;height:56px;display:block;object-fit:cover;border-radius:2px;margin:0;}
    .blog-thumb-ph{width:80px;height:56px;background:rgba(124,106,247,0.06);display:flex;align-items:center;justify-content:center;color:rgba(124,106,247,0.4);flex-shrink:0;}
    .blog-body{min-width:0;overflow:hidden}
    .blog-date{font-family:'JetBrains Mono',monospace;font-size:0.62rem;color:var(--accent-light);margin-bottom:0.2rem}
    .blog-ptitle{font-size:0.88rem;font-weight:700;line-height:1.38;margin-bottom:0.28rem;word-break:break-word}
    .blog-pdesc{font-size:0.73rem;line-height:1.5;color:var(--text-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .blog-tags{margin-top:0.38rem;display:flex;gap:0.22rem;flex-wrap:wrap}
    .blog-tag{font-family:'JetBrains Mono',monospace;font-size:0.58rem;color:rgba(124,106,247,0.6);border:1px solid rgba(124,106,247,0.18);padding:0.06rem 0.35rem;white-space:nowrap}
    .blog-pagination{display:flex;gap:0.3rem;margin-top:1.4rem;align-items:center;flex-wrap:wrap;padding-bottom:2rem}
    .blog-pg-btn,.blog-pg-num{font-family:'JetBrains Mono',monospace;font-size:0.7rem;cursor:pointer;padding:0.35rem 0.6rem;border:1px solid var(--border);background:transparent;color:var(--text-muted);}
    .blog-pg-btn{color:var(--accent-light);border-color:rgba(124,106,247,0.3);}
    .blog-pg-num.active,.blog-pg-num:hover,.blog-pg-btn:hover{border-color:rgba(124,106,247,0.4);color:var(--accent-light);background:rgba(124,106,247,0.06)}
    .blog-no-result{padding:2rem;text-align:center;font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:var(--text-muted)}
    .blog-post-list mark{background:rgba(124,106,247,0.28);color:#fff;padding:0 1px;border-radius:1px}
  </style>
  <div class="blog-wrap">
    <div class="blog-search-bar-wrap"><div class="blog-search-inner"><span class="blog-search-icon">🔍</span><input id="search-input" class="blog-search-input" type="search" placeholder="제목·태그·설명 검색..." autocomplete="off" /></div></div>
    <div class="blog-cat-wrap"><div class="blog-cat-chips"><a href={`${base}/blog`} class="blog-cat-chip">ALL {allPosts.length}</a>{sortedTags.map(([tag,count]) => <a href={`${base}/category/${tag.toLowerCase().replace(/\s+/g,'-')}`} class="blog-cat-chip">{tag} {count}</a>)}</div></div>
    <div class="blog-head"><h1>BLOG</h1><span class="blog-result-info" id="result-info"></span></div>
    <div class="blog-post-list" id="post-list"></div>
    <div class="blog-pagination" id="pagination"></div>
  </div>
  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)}></script>
  <script>
    const INDEX = JSON.parse(document.getElementById('search-data').textContent);
    const PER_PAGE = 10;
    let currentPage = 1;
    let currentQuery = '';

    const inp = document.getElementById('search-input');
    const list = document.getElementById('post-list');
    const pagi = document.getElementById('pagination');
    const info = document.getElementById('result-info');

    function esc(s) { return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function hl(text, q) {
      if (!q.trim()) return esc(text);
      const terms = q.trim().split(/\s+/).map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      return esc(text).replace(new RegExp(`(${terms.join('|')})`, 'gi'), '<mark>$1</mark>');
    }
    function score(p, q) {
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      let s = 0;
      for (const t of terms) {
        if (p.title.toLowerCase().includes(t)) s += 10;
        if (p.description.toLowerCase().includes(t)) s += 5;
        if (p.tags.some(x => x.toLowerCase().includes(t))) s += 8;
      }
      return s;
    }
    function cardHTML(p, q) {
      const thumb = p.heroImage ? `<img class="blog-thumb" src="${esc(p.heroImage)}" alt="" />` : `<div class="blog-thumb-ph">📊</div>`;
      const tags = (p.tags || []).slice(0, 3).map(t => `<span class="blog-tag">${esc(t)}</span>`).join('');
      return `<a href="${esc(p.url)}" class="blog-post-card">${thumb}<div class="blog-body"><div class="blog-date">${esc(p.date)}</div><div class="blog-ptitle">${hl(p.title, q)}</div><div class="blog-pdesc">${hl(p.description, q)}</div><div class="blog-tags">${tags}</div></div></a>`;
    }

    function renderPage(posts, page, q) {
      const totalPages = Math.ceil(posts.length / PER_PAGE);
      const slice = posts.slice((page - 1) * PER_PAGE, page * PER_PAGE);

      if (q.trim()) {
        info.textContent = `검색 ${posts.length}건`;
      } else {
        info.textContent = `${INDEX.length} POSTS — ${page}/${totalPages}`;
      }

      list.innerHTML = slice.length
        ? slice.map(p => cardHTML(p, q)).join('')
        : `<div class="blog-no-result">결과 없음 — "${esc(q)}"</div>`;

      // 페이지네이션 버튼 렌더
      if (totalPages <= 1) { pagi.innerHTML = ''; return; }

      let html = '';
      if (page > 1) html += `<button class="blog-pg-btn" data-p="${page - 1}">← PREV</button>`;

      // 번호 너무 많으면 앞뒤 2개 + 현재 기준 ±2만 표시
      const pages = [];
      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || Math.abs(i - page) <= 2) pages.push(i);
      }
      let prev = 0;
      for (const p of pages) {
        if (prev && p - prev > 1) html += `<span style="padding:0.35rem 0.3rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:0.7rem;">…</span>`;
        html += `<button class="blog-pg-num${p === page ? ' active' : ''}" data-p="${p}">${p}</button>`;
        prev = p;
      }

      if (page < totalPages) html += `<button class="blog-pg-btn" data-p="${page + 1}">NEXT →</button>`;
      pagi.innerHTML = html;

      pagi.querySelectorAll('button[data-p]').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.getAttribute('data-p'));
          renderPage(filteredPosts(), currentPage, currentQuery);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }

    function filteredPosts() {
      const q = currentQuery.trim();
      if (!q) return INDEX;
      return INDEX.map(p => ({ p, s: score(p, q) })).filter(r => r.s > 0).sort((a, b) => b.s - a.s).map(r => r.p);
    }

    function render() {
      const posts = filteredPosts();
      renderPage(posts, currentPage, currentQuery);
    }

    let t;
    inp.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        currentQuery = inp.value;
        currentPage = 1;
        render();
      }, 160);
    });

    // 초기 렌더
    render();
  </script>
</BaseLayout>
