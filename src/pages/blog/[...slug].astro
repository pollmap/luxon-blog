---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — Luxon AI</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root { --bg: #0D0D1A; --purple: #7C6AF7; --white: #FFFFFF; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--bg); color: var(--white); font-family: 'Noto Sans KR', sans-serif; }
    nav { position: fixed; top: 0; width: 100%; z-index: 100; padding: 1.5rem 3rem; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(10px); background: rgba(13,13,26,0.8); }
    .logo { font-size: 1.4rem; font-weight: 900; color: var(--purple); text-decoration: none; }
    nav a { color: rgba(255,255,255,0.7); text-decoration: none; margin-left: 2rem; font-size: 0.9rem; }
    article { max-width: 780px; margin: 0 auto; padding: 8rem 2rem 4rem; }
    .hero-img { width: 100%; height: 300px; object-fit: cover; margin-bottom: 2rem; filter: brightness(0.8); }
    .meta { font-size: 0.8rem; color: var(--purple); margin-bottom: 1rem; letter-spacing: 0.1em; }
    h1 { font-size: 2.2rem; font-weight: 900; line-height: 1.3; margin-bottom: 2rem; }
    .content { line-height: 1.9; color: rgba(255,255,255,0.85); }
    .content h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; color: var(--white); }
    .content h3 { font-size: 1.2rem; margin: 2rem 0 0.8rem; color: rgba(255,255,255,0.9); }
    .content p { margin-bottom: 1.2rem; }
    .content a { color: var(--purple); text-decoration: underline; }
    .content a:hover { opacity: 0.8; }
    .content strong, .content b { font-weight: 700; color: #fff; }
    .content em, .content i { font-style: italic; color: rgba(255,255,255,0.9); }
    .content code { font-family: 'JetBrains Mono', monospace; background: rgba(124,106,247,0.12); padding: 0.15rem 0.4rem; font-size: 0.85em; color: var(--purple); border-radius: 2px; }
    .content pre { background: rgba(0,0,0,0.4); border: 1px solid rgba(124,106,247,0.2); padding: 1.5rem; overflow-x: auto; margin: 1.5rem 0; }
    .content pre code { background: none; padding: 0; color: rgba(255,255,255,0.85); }
    .content ul, .content ol { padding-left: 1.8rem; margin-bottom: 1.2rem; }
    .content li { margin-bottom: 0.5rem; line-height: 1.7; }
    .content hr { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 2.5rem 0; }
    .content blockquote { border-left: 3px solid var(--purple); padding-left: 1.5rem; margin: 1.5rem 0; color: rgba(255,255,255,0.6); font-style: italic; }
    .content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
    .content th, .content td { border: 1px solid rgba(255,255,255,0.1); padding: 0.7rem 1rem; text-align: left; }
    .content th { background: rgba(124,106,247,0.1); color: var(--purple); font-weight: 700; }
    .back { display: inline-block; margin-top: 3rem; color: var(--purple); text-decoration: none; font-size: 0.85rem; }
    .back:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <nav>
    <a href={`${base}/`} class="logo">LUXON_AI</a>
    <div>
      <a href={`${base}/`}>HOME</a>
      <a href={`${base}/blog`}>BLOG</a>
      <a href="https://github.com/pollmap" target="_blank">GITHUB</a>
    </div>
  </nav>
  <article>
    {post.data.heroImage && <img class="hero-img" src={post.data.heroImage} alt={post.data.title} />}
    <div class="meta">{post.data.date.toISOString().slice(0,10)}</div>
    <h1>{post.data.title}</h1>
    <div class="content">
      <Content />
    </div>
    <a href={`${base}/blog`} class="back">← BACK TO BLOG</a>
  </article>
</body>
</html>
