---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${post.data.title} — Luxon AI`} description={post.data.description || post.data.title} image={post.data.heroImage || undefined}>
  <style>
    .article-wrap{max-width:860px;margin:0 auto;padding:5.8rem 1rem 0;}
    .article-card{background:var(--bg-secondary);border:1px solid var(--border);padding:1.2rem;}
    .hero-img{width:100%;height:min(42vw,340px);min-height:220px;object-fit:cover;display:block;filter:brightness(0.82);margin-bottom:1.25rem;}
    .meta{font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--accent-light);margin-bottom:0.6rem;letter-spacing:0.08em;}
    h1{font-size:clamp(1.7rem,4vw,2.6rem);font-weight:800;line-height:1.25;margin-bottom:1.2rem;color:#fff;word-break:break-word;}
    .content{line-height:1.85;color:#D0D0E8;font-size:0.98rem;}
    .content h2,.content h3,.content h4{color:#fff;line-height:1.3;}
    .content h2{font-size:1.45rem;margin:2.3rem 0 0.9rem;padding-bottom:0.45rem;border-bottom:1px solid var(--border);}
    .content h3{font-size:1.15rem;margin:1.8rem 0 0.7rem;}
    .content p{margin-bottom:1.05rem;word-break:break-word;}
    .content a{color:var(--accent-light);text-decoration:underline;}
    .content code{font-family:'JetBrains Mono',monospace;background:rgba(124,106,247,0.12);padding:0.12rem 0.35rem;font-size:0.88em;color:var(--accent-light);border:1px solid rgba(124,106,247,0.15);border-radius:4px;}
    .content pre{background:#0b0b17;border:1px solid var(--border);padding:1rem;overflow:auto;margin:1.2rem 0;}
    .content pre code{background:none;border:none;padding:0;color:#D0D0E8;}
    .content ul,.content ol{padding-left:1.4rem;margin-bottom:1rem;}
    .content blockquote{border-left:3px solid var(--accent);padding-left:1rem;color:#B8B8D8;margin:1rem 0;}
    .content table{width:100%;border-collapse:collapse;display:block;overflow:auto;margin:1rem 0;}
    .content th,.content td{border:1px solid var(--border);padding:0.6rem 0.8rem;text-align:left;}
    .content th{background:rgba(124,106,247,0.08);color:var(--accent-light);}
    .back{display:inline-flex;margin-top:1.4rem;align-items:center;gap:0.35rem;color:var(--accent-light);text-decoration:none;font-family:'JetBrains Mono',monospace;font-size:0.72rem;}
  </style>

  <div class="article-wrap">
    <article class="article-card">
      {post.data.heroImage && <img class="hero-img" src={post.data.heroImage} alt={post.data.title} />}
      <div class="meta">{post.data.date.toISOString().slice(0,10)}</div>
      <h1>{post.data.title}</h1>
      <div class="content"><Content /></div>
      <a href={`${base}/blog`} class="back">← BACK TO BLOG</a>
    </article>
  </div>
</BaseLayout>
