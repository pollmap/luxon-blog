---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap(p => p.data.tags || []))];
  return tags.map(tag => ({
    params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
    props: { tag, posts: posts.filter(p => (p.data.tags || []).includes(tag)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()) }
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = await getCollection('blog');
const tagCounts = allPosts.flatMap(p => p.data.tags || []).reduce((acc, t) => {
  acc[t] = (acc[t] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---
<BaseLayout title={`${tag} — Luxon AI`} description={`${tag} 카테고리 글 목록`}>
  <style>
    .wrap{max-width:860px;margin:0 auto;padding:5.7rem 1rem 0;}
    .cat-wrap{margin-bottom:1rem;overflow-x:auto;scrollbar-width:none;}
    .cat-wrap::-webkit-scrollbar{display:none;}
    .cat-chips{display:flex;gap:0.4rem;width:max-content;padding-bottom:2px;}
    .cat-chip{display:inline-block;padding:0.3rem 0.7rem;background:var(--bg-secondary);border:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--text-muted);text-decoration:none;white-space:nowrap;}
    .cat-chip.active,.cat-chip:hover{color:var(--accent-light);border-color:rgba(124,106,247,0.35);background:rgba(124,106,247,0.06);}
    .head{display:flex;flex-wrap:wrap;gap:0.6rem;align-items:baseline;margin-bottom:1rem;}
    .label{font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--accent-light);letter-spacing:0.12em;}
    .title{font-size:1.35rem;font-weight:800;color:#fff;word-break:break-word;}
    .count{font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--text-muted);}
    .post-list{display:flex;flex-direction:column;gap:1px;background:var(--border);}
    .post-card{background:var(--bg-primary);display:grid;grid-template-columns:80px 1fr;gap:0.8rem;padding:0.9rem;text-decoration:none;color:inherit;border:1px solid transparent;}
    .post-card:hover{border-color:rgba(124,106,247,0.25);background:rgba(124,106,247,0.02);}
    .thumb,.thumb-ph{width:80px;height:56px;display:block;object-fit:cover;}
    .thumb-ph{background:rgba(124,106,247,0.06);display:flex;align-items:center;justify-content:center;color:rgba(124,106,247,0.4)}
    .body{min-width:0;overflow:hidden;}
    .date{font-family:'JetBrains Mono',monospace;font-size:0.62rem;color:var(--accent-light);margin-bottom:0.2rem;}
    .ptitle{font-size:0.88rem;font-weight:700;line-height:1.38;margin-bottom:0.28rem;word-break:break-word;}
    .pdesc{font-size:0.73rem;line-height:1.5;color:var(--text-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  </style>
  <div class="wrap">
    <div class="cat-wrap"><div class="cat-chips">
      <a href={`${base}/blog`} class="cat-chip">ALL {allPosts.length}</a>
      {sortedTags.map(([t,count]) => <a href={`${base}/category/${t.toLowerCase().replace(/\s+/g,'-')}`} class={`cat-chip ${t===tag?'active':''}`}>{t} {count}</a>)}
    </div></div>
    <div class="head"><div class="label">CATEGORY</div><div class="title">{tag}</div><div class="count">{posts.length} POSTS</div></div>
    <div class="post-list">
      {posts.map(post => (
        <a href={`${base}/blog/${post.id}`} class="post-card">
          {post.data.heroImage ? <img class="thumb" src={post.data.heroImage} alt="" /> : <div class="thumb-ph">📊</div>}
          <div class="body">
            <div class="date">{post.data.date.toISOString().slice(0,10)}</div>
            <div class="ptitle">{post.data.title}</div>
            <div class="pdesc">{post.data.description || ''}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
