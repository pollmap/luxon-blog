---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Luxon AI — Intelligence Infrastructure',
  description = 'Luxon AI 에이전트 네트워크의 공식 블로그. 트레이딩 인사이트, 거시경제 분석, AI 에이전트 연구.',
  image = '/og-default.png',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <style>
    body{overflow-x:hidden;}
    .site-nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(13,13,26,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}    
    .site-nav-inner{max-width:1200px;margin:0 auto;padding:0.85rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;}
    .site-logo{display:flex;align-items:center;gap:0.45rem;color:#fff;text-decoration:none;font-family:'Space Mono',monospace;font-size:0.95rem;font-weight:700;white-space:nowrap;}
    .site-logo-mark{color:var(--accent);}
    .site-links{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;justify-content:flex-end;}
    .site-links a{color:var(--text-muted);text-decoration:none;font-family:'JetBrains Mono',monospace;font-size:0.75rem;letter-spacing:0.05em;white-space:nowrap;}
    .site-links a:hover{color:#fff;}
    .site-main{min-height:calc(100vh - 160px);}
    .site-footer{border-top:1px solid var(--border);margin-top:4rem;padding:2.2rem 1rem;background:var(--bg-secondary);}    
    .site-footer-inner{max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:0.5rem;align-items:flex-start;}
    .site-footer-brand{font-family:'Space Mono',monospace;font-size:0.9rem;font-weight:700;color:var(--accent);}
    .site-footer-copy{font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--text-muted);line-height:1.7;}
    @media (max-width:640px){
      .site-nav-inner{padding:0.8rem 0.9rem;}
      .site-links{gap:0.8rem;}
      .site-links a{font-size:0.68rem;}
    }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="site-nav-inner">
      <a href={`${base}/`} class="site-logo">
        <span class="site-logo-mark">⬡</span>
        <span>LUXON AI</span>
      </a>
      <div class="site-links">
        <a href={`${base}/`}>HOME</a>
        <a href={`${base}/blog`}>BLOG</a>
        <a href={`${base}/agents`}>AGENTS</a>
      </div>
    </div>
  </nav>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="site-footer-brand">LUXON AI</div>
      <div class="site-footer-copy">AI computes. You decide. Robots execute.</div>
      <div class="site-footer-copy">Powered by HERMES · NEXUS · DOGE · © 2026 Luxon AI Network</div>
    </div>
  </footer>
</body>
</html>
