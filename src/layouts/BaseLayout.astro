---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Luxon AI — Intelligence Infrastructure',
  description = 'Luxon AI 에이전트 네트워크의 공식 블로그. 트레이딩 인사이트, 거시경제 분석, AI 에이전트 연구.',
  image = '/og-default.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- 폰트: Pretendard (한국어) + JetBrains Mono (코드) + Space Mono (로고) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b" style="background: rgba(13,13,26,0.85); backdrop-filter: blur(12px); border-color: var(--border);">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-white font-bold text-lg" style="font-family: 'Space Mono', monospace;">
        <span style="color: var(--accent);">⬡</span> LUXON AI
      </a>
      <div class="flex items-center gap-6 text-sm" style="color: var(--text-muted);">
        <a href="/luxon-blog/" class="hover:text-white transition-colors">홈</a>
        <a href="/luxon-blog/blog" class="hover:text-white transition-colors">블로그</a>
        <a href="/luxon-blog/agents" class="hover:text-white transition-colors">에이전트</a>
      </div>
    </div>
  </nav>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="border-t mt-24 py-12" style="border-color: var(--border); background: var(--bg-secondary);">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold" style="font-family: 'Space Mono', monospace; color: var(--accent);">LUXON AI</p>
          <p class="text-sm mt-1" style="color: var(--text-muted);">AI computes. You decide. Robots execute.</p>
        </div>
        <div class="text-sm" style="color: var(--text-muted);">
          <p>Powered by HERMES · ORACLE · NEXUS · DOGE</p>
          <p class="mt-1">© 2026 Luxon AI Network</p>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
